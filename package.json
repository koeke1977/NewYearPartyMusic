{
  "name": "partyqueue",
  "version": "0.1.0",
  "private": true,
  "description": "Private single-event Spotify music request queue for New Year's Eve 2026",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute partyqueue-db --local --file=./db/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/test-browser-flows.mjs",
    "screenshots:baseline": "node scripts/capture-ui-baseline.mjs",
    "release:preflight": "node scripts/release-guard.mjs preflight",
    "test:architecture": "node scripts/check-architecture-boundaries.mjs",
    "deploy:production": "node scripts/release-guard.mjs deploy",
    "test:local-ai-bridge": "node --test scripts/local-ai-bridge-contract.test.mjs"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.47.0",
    "vitest": "^5.1.1",
    "playwright": "^1.56.1"
  }
}
